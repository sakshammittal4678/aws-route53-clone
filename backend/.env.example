# Server Port (Render sets $PORT automatically)
PORT=8000

# Secret key for JWT session tokens (Set to a secure random string in production)
SECRET_KEY=aws-route53-production-secret-key-super-secure-change-this

# CORS allowed origins (comma-separated list of URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite database file path or full SQLAlchemy database URL
SQLITE_PATH=./route53.db
DATABASE_URL=sqlite:///./route53.db
